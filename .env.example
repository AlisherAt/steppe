# Только серверные переменные. Не добавляйте NEXT_PUBLIC_ к секретам.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# nbk | manual | authorized-json (включая Kaspi только при разрешённом доступе)
RATE_PROVIDER=nbk
RATE_MAX_AGE_HOURS=120
RATE_FALLBACK=none
# Ручной резерв: задаются вместе; rates — KZT за 1 единицу валюты.
MANUAL_RATES_JSON=
MANUAL_RATE_AS_OF=
MANUAL_RATE_LABEL=Ручной курс оператора
AUTHORIZED_RATE_URL=
AUTHORIZED_RATE_HOSTS=
AUTHORIZED_RATE_TOKEN=
AUTHORIZED_RATE_LABEL=
AUTHORIZED_RATE_PERMISSION=
# URL разрешённого фида; формат по умолчанию JSON, остальные см. docs/sources.md.
NIKE_FEED_URL=
NIKE_FEED_HOSTS=
NIKE_FEED_TOKEN=
NIKE_FEED_PERMISSION=
NIKE_PRODUCT_HOSTS=www.nike.com,nike.com
ADIDAS_FEED_URL=
ADIDAS_FEED_HOSTS=
ADIDAS_FEED_TOKEN=
ADIDAS_FEED_PERMISSION=
ADIDAS_PRODUCT_HOSTS=www.adidas.com,adidas.com
# Точные домены изображений из разрешённых фидов; после изменения нужен redeploy.
PRODUCT_IMAGE_HOSTS=
OFFER_MAX_AGE_HOURS=36

# Альтернативы: каждый источник — ОДИН выбранный магазин, не вся сеть.
# STORE_NAME — настоящее название магазина, оно попадёт в карточки.
ADMITAD_STORE_NAME=
ADMITAD_FEED_URL=
ADMITAD_FEED_HOSTS=
ADMITAD_FEED_TOKEN=
ADMITAD_FEED_PERMISSION=
ADMITAD_PRODUCT_HOSTS=
ADMITAD_FEED_FORMAT=yml
ADMITAD_FEED_TIMEZONE=+03:00
AWIN_STORE_NAME=
AWIN_FEED_URL=
AWIN_FEED_HOSTS=
AWIN_FEED_PERMISSION=
AWIN_PRODUCT_HOSTS=
AWIN_FEED_FORMAT=awin-csv
AWIN_FEED_TIMEZONE=+00:00
GDESLON_STORE_NAME=
GDESLON_FEED_URL=
GDESLON_FEED_HOSTS=
GDESLON_FEED_PERMISSION=
GDESLON_PRODUCT_HOSTS=
GDESLON_FEED_FORMAT=yml
GDESLON_FEED_TIMEZONE=+03:00
RETAILER_STORE_NAME=
RETAILER_FEED_URL=
RETAILER_FEED_HOSTS=
RETAILER_FEED_PERMISSION=
RETAILER_PRODUCT_HOSTS=
RETAILER_FEED_FORMAT=yml
RETAILER_FEED_TIMEZONE=+05:00
GOOGLE_FEED_STORE_NAME=
GOOGLE_FEED_FEED_URL=
GOOGLE_FEED_FEED_HOSTS=
GOOGLE_FEED_FEED_PERMISSION=
GOOGLE_FEED_PRODUCT_HOSTS=
GOOGLE_FEED_FEED_FORMAT=google-xml
# Каждый префикс также поддерживает *_FEED_SIZES_EU=false,
# *_FEED_CATEGORY= (подстрока категории для отбора кроссовок),
# *_FEED_ALLOW_EMPTY=false. Не подтверждайте EU для US/UK размеров.

# eBay: только production, без sandbox-товаров в каталоге.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_API_PERMISSION=
EBAY_QUERY=sneakers

# Дополнительные магазины без изменения кода (до 20), секреты отдельно в ENV.
# Пример: [{"id":"my-store","name":"Мой магазин","prefix":"MY_STORE","format":"yml"}]
ADDITIONAL_SOURCES_JSON=[]

# Подтверждение регионального экспорта и регулярного обновления, см. docs/sources.md.
